<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>منوی دیجیتال کافه رستوران لوکس | Luxury 3D Menu</title>
  
  <!-- فونت وزیرمتن -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- QRCode.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <!-- پیکربندی پالت رنگی دارک لوکس طلایی -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Vazirmatn', 'sans-serif'],
          },
          colors: {
            obsidian: '#08080a',
            charcoal: '#111216',
            cardBg: 'rgba(22, 24, 30, 0.75)',
            gold: {
              300: '#fef08a',
              400: '#facc15',
              500: '#eab308',
              600: '#ca8a04',
              chrome: 'linear-gradient(135deg, #FFF6D5 0%, #D4AF37 50%, #AA771C 100%)'
            }
          },
          boxShadow: {
            '3d-glow': '0 20px 40px -15px rgba(234, 179, 8, 0.25)',
            'card-deep': '0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 1px 1px rgba(255, 215, 0, 0.1)',
            'neon-gold': '0 0 25px rgba(234, 179, 8, 0.45)',
          }
        }
      }
    }
  </script>

  <style>
    /* استایل‌های پرسپکتیو و تعامل سه‌بعدی */
    body {
      background-color: #08080a;
      perspective: 1200px;
      overflow-x: hidden;
    }

    .perspective-container {
      perspective: 1000px;
    }

    /* کارت 3D تعاملی با حفظ فضای سه‌بعدی */
    .card-3d {
      transform-style: preserve-3d;
      transition: transform 0.18s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s ease;
      will-change: transform;
    }

    .card-3d:hover {
      box-shadow: 0 30px 60px -12px rgba(234, 179, 8, 0.3), 0 0 0 1px rgba(234, 179, 8, 0.4);
    }

    .translate-z-badge {
      transform: translateZ(40px);
    }

    .translate-z-img {
      transform: translateZ(50px) scale(1.02);
      filter: drop-shadow(0 20px 25px rgba(0,0,0,0.8));
      transition: transform 0.3s ease;
    }

    .card-3d:hover .translate-z-img {
      transform: translateZ(65px) scale(1.06);
    }

    .translate-z-text {
      transform: translateZ(30px);
    }

    .translate-z-btn {
      transform: translateZ(45px);
    }

    /* بازتاب نور شیشه‌ای سه‌بعدی (Sheen Effect) */
    .shine-glare {
      position: absolute;
      inset: 0;
      border-radius: 1.5rem;
      background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255, 255, 255, 0.18), transparent 60%);
      opacity: 0;
      transition: opacity 0.3s;
      pointer-events: none;
      z-index: 20;
    }

    .card-3d:hover .shine-glare {
      opacity: 1;
    }

    /* انیمیشن پالس شناور نئونی طلایی */
    @keyframes floatOrb {
      0%, 100% { transform: translateY(0px) scale(1); }
      50% { transform: translateY(-20px) scale(1.08); }
    }

    .animate-orb {
      animation: floatOrb 9s ease-in-out infinite;
    }

    /* اسکرول‌بار ظریف تیره */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #08080a;
    }
    ::-webkit-scrollbar-thumb {
      background: #27272a;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #ca8a04;
    }

    /* دکمه اکشن متالیک کروم طلایی */
    .btn-gold-3d {
      background: linear-gradient(135deg, #FFE27D 0%, #D4AF37 45%, #996515 100%);
      box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3), inset 0 1px 1px rgba(255, 255, 255, 0.6);
      transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .btn-gold-3d:hover {
      transform: translateY(-2px) scale(1.03);
      box-shadow: 0 8px 25px rgba(212, 175, 55, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.8);
    }
    .btn-gold-3d:active {
      transform: translateY(1px) scale(0.98);
    }
  </style>
</head>

<body class="text-zinc-200 min-h-screen relative selection:bg-yellow-500 selection:text-black">

  <!-- پس‌زمینه آمبیانت با اورب‌های نورانی سه بعدی -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <div class="absolute -top-32 right-1/4 w-96 h-96 bg-amber-500/10 rounded-full blur-[140px] animate-orb"></div>
    <div class="absolute top-1/2 -left-32 w-80 h-80 bg-yellow-600/10 rounded-full blur-[130px] animate-orb" style="animation-delay: -4s;"></div>
    <div class="absolute -bottom-32 right-1/3 w-96 h-96 bg-amber-700/10 rounded-full blur-[150px] animate-orb" style="animation-delay: -2s;"></div>
    <!-- پترن شبکه فضایی متالیک -->
    <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.03)_1px,transparent_1px)] [background-size:28px_28px] opacity-70"></div>
  </div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 py-6 sm:py-10">

    <!-- نوار هدر برندینگ سه بعدی و ابزارها -->
    <header class="flex flex-col md:flex-row items-center justify-between gap-6 mb-12 p-6 rounded-3xl bg-zinc-900/60 backdrop-blur-2xl border border-zinc-800/80 shadow-2xl">
      <div class="flex items-center gap-4">
        <!-- لوگوی سه‌بعدی لوکس با انعکاس نوری -->
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-yellow-300 via-amber-500 to-yellow-800 p-[1.5px] shadow-3d-glow">
          <div class="w-full h-full bg-zinc-950 rounded-[14px] flex items-center justify-center">
            <i data-lucide="sparkles" class="w-8 h-8 text-yellow-400"></i>
          </div>
        </div>
        <div>
          <h1 class="text-2xl sm:text-3xl font-black tracking-tight bg-gradient-to-r from-amber-100 via-amber-300 to-yellow-500 bg-clip-text text-transparent">
            کافه رستوران لورنس
          </h1>
          <p class="text-xs sm:text-sm text-zinc-400 flex items-center gap-2 mt-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            منوی آنلاین سه‌بعدی اختصاصی • به‌روزرسانی زنده
