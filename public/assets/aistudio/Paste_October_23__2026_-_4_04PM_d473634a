        desc: 'سیروپ کوراسائو بلو، لیمو ترش تاره شیرازی، سودا، یخ دودی و کف مخملی نعنا',
        available: true
      },
      {
        id: '4',
        name: 'آیس دراگون وگن بری',
        category: 'cold-drinks',
        price: 155000,
        tag: 'vegan',
        image: 'https://images.unsplash.com/photo-1551024709-8f23befc6f87?auto=format&fit=crop&w=600&q=80',
        desc: 'پوره دراگون فروت طبیعی، شیر بادام شیرین نشده، کرنبری و چیاسید ارگانیک',
        available: true
      },
      {
        id: '5',
        name: 'چیزکیک سن سباستین طلا',
        category: 'dessert',
        price: 175000,
        tag: 'special',
        image: 'https://images.unsplash.com/photo-1508737027454-e6454ef45afd?auto=format&fit=crop&w=600&q=80',
        desc: 'بافت کرمی کاراملی شده با مرکز ذوب شونده همراه با سس بلژیکی گرم و ورق طلای خوراکی',
        available: true
      },
      {
        id: '6',
        name: 'تارت دارک چاکلت و نمک دریا',
        category: 'dessert',
        price: 160000,
        tag: 'none',
        image: 'https://images.unsplash.com/photo-1606313564200-e75d5e30476c?auto=format&fit=crop&w=600&q=80',
        desc: 'گاناش شکلات تلخ ۷۴ درصد گانایی، کراست کره فرانسوی و فلیک‌های نمک مالدون',
        available: true
      },
      {
        id: '7',
        name: 'تست آووکادو و تخم‌مرغ پوچد',
        category: 'food',
        price: 210000,
        tag: 'special',
        image: 'https://images.unsplash.com/photo-1525351484163-7529414344d8?auto=format&fit=crop&w=600&q=80',
        desc: 'نان ساوردو تازه برشته، کرم آووکادو، تخم‌مرغ پوچد با زرده روان و پاپریکای دودی',
        available: true
      }
    ];

    let items = JSON.parse(localStorage.getItem('luxury_menu_items')) || initialItems;
    let activeCategory = 'all';
    let searchQuery = '';
    let cart = {};

    function saveToStorage() {
      localStorage.setItem('luxury_menu_items', JSON.stringify(items));
    }

    function formatNumber(num) {
      return new Intl.NumberFormat('fa-IR').format(num);
    }

    // رندر کارت‌ها با ساختار سه‌بعدی لایه‌بندی شده
    function renderMenu() {
      const grid = document.getElementById('menuGrid');
      const emptyState = document.getElementById('emptyState');
      grid.innerHTML = '';

      const filtered = items.filter(item => {
        const matchesCategory = activeCategory === 'all' || item.category === activeCategory;
        const matchesSearch = item.name.toLowerCase().includes(searchQuery.toLowerCase()) || 
                              item.desc.toLowerCase().includes(searchQuery.toLowerCase());
        return matchesCategory && matchesSearch;
      });

      if (filtered.length === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }

      filtered.forEach(item => {
        const card = document.createElement('div');
        card.className = "card-3d relative rounded-3xl bg-zinc-900/80 border border-zinc-800/90 p-5 flex flex-col justify-between overflow-hidden backdrop-blur-xl group cursor-pointer shadow-card-deep";
        card.setAttribute('data-id', item.id);

        let tagBadge = '';
        if (item.tag === 'special') {
          tagBadge = `<span class="translate-z-badge px-3 py-1 rounded-full text-[11px] font-bold bg-amber-500/20 text-yellow-300 border border-amber-500/40">پیشنهاد سرآشپز ⭐</span>`;
        } else if (item.tag === 'popular') {
          tagBadge = `<span class="translate-z-badge px-3 py-1 rounded-full text-[11px] font-bold bg-rose-500/20 text-rose-300 border border-rose-500/40">محبوب‌ترین 🔥</span>`;
        } else if (item.tag === 'vegan') {
          tagBadge = `<span class="translate-z-badge px-3 py-1 rounded-full text-[11px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">گیاهی 🌱</span>`;
        }

        const countInCart = cart[item.id] || 0;

        card.innerHTML = `
          <div class="shine-glare"></div>
          
          <!-- لایه تصویر سه‌بعدی با عمق بالا -->
          <div class="relative w-full h-52 rounded-2xl overflow-hidden mb-5 bg-zinc-950/60 shadow-2xl">
            <img src="${item.image}" alt="${item.name}" loading="lazy" class="translate-z-img w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-transparent opacity-80"></div>
            
            <div class="absolute top-3 right-3 z-30">
              ${tagBadge}
            </div>

            <!-- دکمه‌های کنترل سریع برای ادمین -->
            <div class="absolute top-3 left-3 z-30 flex gap-1.5 opacity-0 group-hover:opacity-100 transition-opacity">
              <button onclick="editItem('${item.id}', event)" class="p-2 rounded-xl bg-zinc-900/90 hover:bg-zinc-800 text-yellow-400 border border-zinc-700 shadow-md">
                <i data-lucide="edit-2" class="w-3.5 h-3.5"></i>
              </button>
              <button onclick="deleteItem('${item.id}', event)" class="p-2 rounded-xl bg-zinc-900/90 hover:bg-rose-900/80 text-rose-400 border border-zinc-700 shadow-md">
                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
              </button>
            </div>

            ${!item.available ? `
              <div class="absolute inset-0 bg-black/80 backdrop-blur-sm z-20 flex items-center justify-center">
                <span class="px-4 py-1.5 rounded-full bg-zinc-800 text-zinc-300 text-xs font-bold border border-zinc-600">اتمام موجودی</span>
              </div>
            ` : ''}
          </div>

          <!-- لایه متن سه‌بعدی -->
          <div class="translate-z-text flex-1">
            <div class="flex items-start justify-between gap-2 mb-2">
              <h3 class="text-base font-extrabold text-white group-hover:text-yellow-400 transition-colors">
                ${item.name}
              </h3>
            </div>
            <p class="text-xs text-zinc-400 line-clamp-2 leading-relaxed mb-4 font-normal">
              ${item.desc}
            </p>
          </div>

          <!-- بخش قیمت و اکشن اضافه به فاکتور سه‌بعدی -->
          <div class="translate-z-btn pt-4 border-t border-zinc-800/80 flex items-center justify-between mt-auto">
            <div>
              <span class="text-[10px] text-zinc-400 block font-normal">قیمت ویژه:</span>
              <span class="text-base font-black text-amber-400 tracking-tight">
                ${formatNumber(item.price)} <span class="text-xs text-zinc-300 font-normal">تومان</span>
              </span>
            </div>

            ${item.available ? `
              <div class="flex items-center gap-1.5" onclick="event.stopPropagation()">
                ${countInCart > 0 ? `
                  <button onclick="changeCart('${item.id}', -1)" class="w-8 h-8 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white flex items-center justify-center font-bold text-sm shadow">-</button>
                  <span class="w-6 text-center font-bold text-yellow-400 text-sm">${countInCart}</span>
                ` : ''}
                <button onclick="changeCart('${item.id}', 1)" class="btn-gold-3d px-3.5 py-2 rounded-xl text-zinc-950 font-bold text-xs flex items-center gap-1">
                  <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                  <span>${countInCart > 0 ? 'افزودن' : 'سفارش'}</span>
                </button>
              </div>
            ` : `
              <span class="text-xs text-zinc-500 font-medium">ناموجود</span>
            `}
          </div>
        `;

        // رویداد رهگیری ماوس برای افکت تعاملی سه‌بعدی Tilt
        attach3DEffect(card);
        grid.appendChild(card);
      });

      lucide.createIcons();
      updateCartBar();
    }

    // موتور فیزیک سه‌بعدی Tilt با محور ماوس
    function attach3DEffect(card) {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        
        // محاسبه شیب پرسپکتیو با زاویه ملایم و دقیق
        const rotateX = ((y - centerY) / centerY) * -12;
        const rotateY = ((x - centerX) / centerX) * 12;

        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-8px)`;
        card.style.setProperty('--mouse-x', `${(x / rect.width) * 100}%`);
        card.style.setProperty('--mouse-y', `${(y / rect.height) * 100}%`);
      });

      card.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px)';
      });
    }

    // مدیریت سبد فاکتور
    function changeCart(id, delta) {
      if (!cart[id]) cart[id] = 0;
      cart[id] += delta;
      if (cart[id] <= 0) delete cart[id];
      renderMenu();
    }

    function clearCart() {
      cart = {};
      renderMenu();
    }

    function updateCartBar() {
      const cartBar = document.getElementById('cartBar');
      const cartCount = document.getElementById('cartCount');
      const cartTotal = document.getElementById('cartTotal');

      const totalItems = Object.values(cart).reduce((a, b) => a + b, 0);
      let totalPrice = 0;

      for (const [id, count] of Object.entries(cart)) {
        const item = items.find(i => i.id === id);
        if (item) totalPrice += item.price * count;
      }

      if (totalItems > 0) {
        cartCount.textContent = totalItems;
        cartTotal.textContent = `${formatNumber(totalPrice)} تومان`;
        cartBar.classList.remove('translate-y-28', 'opacity-0');
        cartBar.classList.add('translate-y-0', 'opacity-100');
      } else {
        cartBar.classList.add('translate-y-28', 'opacity-0');
        cartBar.classList.remove('translate-y-0', 'opacity-100');
      }
    }

    // فیلتر دسته‌بندی و سرچ
    function setCategory(cat) {
      activeCategory = cat;
      document.querySelectorAll('.cat-btn').forEach(btn => {
        if (btn.getAttribute('data-category') === cat) {
          btn.className = "cat-btn px-5 py-2.5 rounded-2xl bg-amber-500/20 text-yellow-300 border border-yellow-500/50 text-xs sm:text-sm font-bold shadow-3d-glow whitespace-nowrap transition-all";
        } else {
          btn.className = "cat-btn px-5 py-2.5 rounded-2xl bg-zinc-900/80 text-zinc-400 hover:text-white border border-zinc-800 text-xs sm:text-sm font-semibold whitespace-nowrap transition-all";
        }
      });
      renderMenu();
    }

    function handleSearch(val) {
      searchQuery = val;
      renderMenu();
    }

    // پنل مدیریت و عملیات افزودن / ویرایش
    function toggleAdminPanel() {
      const panel = document.getElementById('adminPanel');
      panel.classList.toggle('hidden');
    }

    function resetForm() {
      document.getElementById('editItemId').value = '';
      document.getElementById('itemForm').reset();
    }

    function handleSaveItem(e) {
      e.preventDefault();
      const id = document.getElementById('editItemId').value;
      const name = document.getElementById('itemName').value;
      const category = document.getElementById('itemCategory').value;
      const price = Number(document.getElementById('itemPrice').value);
      const image = document.getElementById('itemImage').value;
      const tag = document.getElementById('itemTag').value;
      const desc = document.getElementById('itemDesc').value;

      if (id) {
        // آپدیت آیتم قبلی
        const index = items.findIndex(i => i.id === id);
        if (index !== -1) {
          items[index] = { ...items[index], name, category, price, image, tag, desc };
        }
      } else {
        // ایجاد آیتم تازه
        const newItem = {
          id: Date.now().toString(),
          name,
          category,
          price,
          image,
          tag,
          desc,
          available: true
        };
        items.unshift(newItem);
      }

      saveToStorage();
      resetForm();
      toggleAdminPanel();
      renderMenu();
    }

    function editItem(id, e) {
      e.stopPropagation();
      const item = items.find(i => i.id === id);
      if (!item) return;

      document.getElementById('editItemId').value = item.id;
      document.getElementById('itemName').value = item.name;
      document.getElementById('itemCategory').value = item.category;
      document.getElementById('itemPrice').value = item.price;
      document.getElementById('itemImage').value = item.image;
      document.getElementById('itemTag').value = item.tag;
      document.getElementById('itemDesc').value = item.desc;

      const panel = document.getElementById('adminPanel');
      if (panel.classList.contains('hidden')) {
        toggleAdminPanel();
      }
      window.scrollTo({ top: panel.offsetTop - 40, behavior: 'smooth' });
    }

    function deleteItem(id, e) {
      e.stopPropagation();
      if (confirm('آیا از حذف این آیتم از منو مطمئن هستید؟')) {
        items = items.filter(i => i.id !== id);
        delete cart[id];
        saveToStorage();
        renderMenu();
      }
    }

    // بارکد QR اختصاصی میز
    function toggleQrModal() {
      const modal = document.getElementById('qrModal');
      modal.classList.toggle('hidden');
      if (!modal.classList.contains('hidden')) {
        const qrContainer = document.getElementById('qrcode');
        qrContainer.innerHTML = '';
        new QRCode(qrContainer, {
          text: window.location.href,
          width: 170,
          height: 170,
          colorDark: "#08080a",
          colorLight: "#ffffff",
          correctLevel: QRCode.CorrectLevel.H
        });
      }
    }

    function copyCurrentLink() {
      navigator.clipboard.writeText(window.location.href);
      const btn = document.getElementById('copyLinkBtn');
      btn.innerHTML = `<i data-lucide="check" class="w-4 h-4 text-emerald-400"></i><span class="text-emerald-400">لینک کپی شد!</span>`;
      lucide.createIcons();
      setTimeout(() => {
        btn.innerHTML = `<i data-lucide="copy" class="w-4 h-4"></i><span>کپی کردن آدرس منو</span>`;
        lucide.createIcons();
      }, 2500);
    }

    // راه‌اندازی اولیه
    document.addEventListener('DOMContentLoaded', () => {
      renderMenu();
    });
  </script>
</body>
</html>