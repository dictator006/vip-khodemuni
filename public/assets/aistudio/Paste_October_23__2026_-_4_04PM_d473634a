      <div class="flex items-center justify-between pb-4 border-b border-zinc-800 mb-6">
        <div class="flex items-center gap-2">
          <i data-lucide="edit-3" class="w-5 h-5 text-yellow-400"></i>
          <h3 class="text-lg font-bold text-white">مدیریت سریع آیتم‌ها و قیمت‌ها</h3>
        </div>
