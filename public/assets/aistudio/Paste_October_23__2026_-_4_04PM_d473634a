          <input type="text" id="itemName" required placeholder="مثال: کارامل ماکیاتو سه‌بعدی" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-sm focus:border-yellow-500 outline-none">
        </div>
        <div>
          <label class="block text-xs text-zinc-400 mb-1">دسته‌بندی</label>
          <select id="itemCategory" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-sm focus:border-yellow-500 outline-none">
