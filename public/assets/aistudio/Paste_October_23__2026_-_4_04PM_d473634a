            <option value="cold-drinks">ماکتیل و بار سرد</option>
            <option value="dessert">کیک و دسرهای دست‌ساز</option>
            <option value="food">میان‌وعده و غذای سرآشپز</option>
          </select>
        </div>
        <div>
          <label class="block text-xs text-zinc-400 mb-1">قیمت (تومان)</label>
          <input type="number" id="itemPrice" required placeholder="مثال: 145000" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-sm focus:border-yellow-500 outline-none">
        </div>
        <div class="sm:col-span-2">
          <label class="block text-xs text-zinc-400 mb-1">آدرس عکس آیتم (URL)</label>
          <input type="url" id="itemImage" required placeholder="https://images.unsplash.com/..." class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-sm focus:border-yellow-500 outline-none">
        </div>
        <div>
          <label class="block text-xs text-zinc-400 mb-1">برچسب ویژگی</label>
          <select id="itemTag" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-sm focus:border-yellow-500 outline-none">
            <option value="popular">محبوب‌ترین 🔥</option>
            <option value="special">پیشنهاد باریستا ⭐</option>
            <option value="vegan">گیاهی وگان 🌱</option>
            <option value="none">بدون نشان</option>
          </select>
        </div>
        <div class="sm:col-span-3">
          <label class="block text-xs text-zinc-400 mb-1">ترکیبات و توضیحات مزه</label>
          <input type="text" id="itemDesc" required placeholder="مثال: اسپرسو دوبل، شیر بافت‌دار، سس کارامل شور خانگی" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-sm focus:border-yellow-500 outline-none">
        </div>
        <div class="sm:col-span-3 flex justify-end gap-3 mt-2">
          <button type="button" onclick="resetForm()" class="px-5 py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-sm">پاک کردن فرم</button>
          <button type="submit" class="btn-gold-3d px-6 py-2 rounded-xl text-zinc-950 font-bold text-sm">ذخیره آیتم در منو</button>
        </div>
      </form>
    </div>

    <!-- نوار جستجو و اکشن فیلترها -->
    <div class="flex flex-col sm:flex-row items-center gap-4 mb-8">
      <div class="relative w-full sm:w-80">
        <i data-lucide="search" class="w-5 h-5 absolute right-4 top-1/2 -translate-y-1/2 text-zinc-500"></i>
        <input type="text" id="searchInput" oninput="handleSearch(this.value)" placeholder="جستجوی طعم یا محصول..." class="w-full bg-zinc-900/80 border border-zinc-800/80 rounded-2xl pr-12 pl-4 py-3 text-sm focus:border-yellow-500 focus:shadow-3d-glow outline-none backdrop-blur-md transition-all">
      </div>

      <!-- تب‌های دسته‌بندی با افکت متالیک -->
      <div class="flex items-center gap-2 overflow-x-auto w-full pb-2 sm:pb-0 no-scrollbar">
        <button onclick="setCategory('all')" class="cat-btn active px-5 py-2.5 rounded-2xl bg-zinc-800 text-zinc-300 hover:text-white border border-zinc-700/60 text-xs sm:text-sm font-semibold whitespace-nowrap transition-all shadow-md" data-category="all">
          همه آیتم‌ها
        </button>
        <button onclick="setCategory('hot-coffee')" class="cat-btn px-5 py-2.5 rounded-2xl bg-zinc-900/80 text-zinc-400 hover:text-white border border-zinc-800 text-xs sm:text-sm font-semibold whitespace-nowrap transition-all" data-category="hot-coffee">
          ☕ قهوه گرم
        </button>
        <button onclick="setCategory('cold-drinks')" class="cat-btn px-5 py-2.5 rounded-2xl bg-zinc-900/80 text-zinc-400 hover:text-white border border-zinc-800 text-xs sm:text-sm font-semibold whitespace-nowrap transition-all" data-category="cold-drinks">
          🍹 بار سرد و ماکتیل
        </button>
        <button onclick="setCategory('dessert')" class="cat-btn px-5 py-2.5 rounded-2xl bg-zinc-900/80 text-zinc-400 hover:text-white border border-zinc-800 text-xs sm:text-sm font-semibold whitespace-nowrap transition-all" data-category="dessert">
          🍰 کیک و دسر
        </button>
        <button onclick="setCategory('food')" class="cat-btn px-5 py-2.5 rounded-2xl bg-zinc-900/80 text-zinc-400 hover:text-white border border-zinc-800 text-xs sm:text-sm font-semibold whitespace-nowrap transition-all" data-category="food">
          🥑 میان‌وعده و خوراک
        </button>
      </div>
    </div>

    <!-- شبکه کارت‌های سه‌بعدی منو (3D Interactive Grid) -->
    <div id="menuGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 perspective-container">
      <!-- کارت‌ها با جاوااسکریپت رندر می‌شوند -->
