          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <form id="itemForm" onsubmit="handleSaveItem(event)" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <input type="hidden" id="editItemId">
        <div>
