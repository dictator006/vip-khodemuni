      </div>

      <!-- دکمه‌های اکشن سریع هدر -->
      <div class="flex items-center gap-3 w-full md:w-auto justify-end">
        <button onclick="toggleQrModal()" class="px-4 py-2.5 rounded-2xl bg-zinc-800/80 hover:bg-zinc-700/80 border border-zinc-700 text-sm font-semibold flex items-center gap-2 transition-all hover:scale-105 active:scale-95 shadow-lg">
