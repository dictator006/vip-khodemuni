          <span>بارکد میز</span>
        </button>
        <button onclick="toggleAdminPanel()" class="px-4 py-2.5 rounded-2xl bg-gradient-to-r from-zinc-800 to-zinc-900 hover:from-zinc-700 hover:to-zinc-800 border border-amber-500/30 text-yellow-300 text-sm font-semibold flex items-center gap-2 transition-all hover:scale-105 active:scale-95 shadow-lg">
          <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
          <span>پنل مدیریت</span>
        </button>
      </div>
    </header>

    <!-- پنل ادمین (Modal / Slide-down) -->
