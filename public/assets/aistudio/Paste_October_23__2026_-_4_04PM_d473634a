      <i data-lucide="coffee" class="w-16 h-16 text-zinc-600 mx-auto mb-4 animate-bounce"></i>
      <h3 class="text-lg font-bold text-zinc-400">محصولی با این مشخصات یافت نشد!</h3>
      <p class="text-sm text-zinc-600 mt-1">عنوان جستجو یا دسته‌بندی را تغییر دهید.</p>
    </div>

    <!-- نوار شناور سبد فاکتور مشتری سه‌بعدی -->
    <div id="cartBar" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40 w-[92%] max-w-xl bg-zinc-900/90 border border-yellow-500/40 rounded-3xl p-4 backdrop-blur-2xl shadow-card-deep flex items-center justify-between transition-all transform duration-300 translate-y-28 opacity-0">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-2xl bg-yellow-500/20 border border-yellow-500/40 flex items-center justify-center text-yellow-400 font-black text-lg" id="cartCount">
          0
        </div>
        <div>
          <div class="text-xs text-zinc-400">جمع فاکتور انتخابی شما:</div>
          <div class="text-lg font-black text-yellow-400" id="cartTotal">۰ تومان</div>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="clearCart()" class="px-3 py-2 text-xs text-zinc-400 hover:text-rose-400 transition">پاک کردن</button>
        <button onclick="alert('فاکتور شما با موفقیت محاسبه شد. سفارش را به سالن‌دار اطلاع دهید.')" class="btn-gold-3d px-5 py-2.5 rounded-2xl text-zinc-950 font-bold text-xs sm:text-sm flex items-center gap-1.5">
          <span>تأیید سفارش</span>
          <i data-lucide="check" class="w-4 h-4"></i>
        </button>
      </div>
    </div>

  </div>

  <!-- مودال بارکد QR سه‌بعدی برای میزها -->
  <div id="qrModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="bg-zinc-900 border border-yellow-500/30 rounded-3xl p-8 max-w-sm w-full text-center relative shadow-card-deep">
      <button onclick="toggleQrModal()" class="absolute top-4 left-4 text-zinc-400 hover:text-white">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
      <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-yellow-500/10 border border-yellow-500/30 flex items-center justify-center text-yellow-400">
        <i data-lucide="qr-code" class="w-8 h-8"></i>
      </div>
      <h3 class="text-xl font-black text-white mb-2">بارکد هوشمند میز</h3>
      <p class="text-xs text-zinc-400 mb-6">این بارکد را اسکن کنید یا آن را برای چاپ بر روی استند میز کافه ذخیره نمایید.</p>
      
      <div class="p-4 bg-white rounded-2xl inline-block mx-auto mb-6 shadow-inner" id="qrcode"></div>

      <div class="flex flex-col gap-2">
        <button onclick="copyCurrentLink()" id="copyLinkBtn" class="w-full py-2.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-xs font-semibold text-zinc-300 flex items-center justify-center gap-2 transition">
          <i data-lucide="copy" class="w-4 h-4"></i>
          <span>کپی کردن آدرس منو</span>
        </button>
      </div>
    </div>
  </div>

  <!-- اسکریپت منطق و سه‌بعدی‌ساز تعاملی منو -->
  <script>
    // پایگاه داده پیش‌فرض محصولات با تم لوکس
    const initialItems = [
      {
        id: '1',
        name: 'اسپرسو سینگل اوریجین اتیوپی',
